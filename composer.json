{
    "name": "laravel-ops/connector",
    "description": "Lightweight connector for Laravel applications to connect to Laravel Ops",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Olusegun, OP Virtual Technology Systems Ltd",
            "email": "pautlnd@gmail.com",
            "role": "Developer"
        }
    ],
    "keywords": [
        "laravel",
        "laravel-ops",
        "connector",
        "monitoring"
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelOps\\Connector\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelOps\\Connector\\ConnectorServiceProvider"
            ]
        }
    }
}
